lb.querySelector(".x").onclick=()=>lb.classList.remove("on");lb.querySelector(".pv").onclick=()=>step(-1);lb.querySelector(".nx").onclick=()=>step(1);
lb.onclick=e=>{if(e.target===lb)lb.classList.remove("on")};
document.addEventListener("keydown",e=>{if(!lb.classList.contains("on"))return;if(e.key==="Escape")lb.classList.remove("on");if(e.key==="ArrowLeft")step(-1);if(e.key==="ArrowRight")step(1)});
/* theme toggle */
$("theme").onclick=()=>{const r=document.documentElement,dark=r.dataset.theme?r.dataset.theme==="dark":matchMedia("(prefers-color-scheme:dark)").matches;r.dataset.theme=dark?"light":"dark"};
/* rotating role */
let ri=0;const rot=$("rot");rot.textContent=D.roles[0];
setInterval(()=>{rot.style.opacity=0;rot.style.transform="translateY(8px)";setTimeout(()=>{ri=(ri+1)%D.roles.length;rot.textContent=D.roles[ri];rot.style.opacity=1;rot.style.transform="none"},450)},2600);
/* scroll progress, active nav, reveal, count-up */
const bar=$("bar");addEventListener("scroll",()=>{const h=document.documentElement;bar.style.width=(scrollY/(h.scrollHeight-innerHeight)*100)+"%"},{passive:true});
const navA=[...document.querySelectorAll(".links a")];
new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting)navA.forEach(a=>a.classList.toggle("on",a.dataset.to===e.target.id))}),{rootMargin:"-45% 0px -50% 0px"}).observe&&secs.forEach(([i])=>{});
const so=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting)navA.forEach(a=>a.classList.toggle("on",a.dataset.to===e.target.id))}),{rootMargin:"-45% 0px -50% 0px"});
secs.forEach(([i])=>so.observe($(i)));
const count=el=>{const m=el.dataset.n.match(/^(\d+(?:\.\d+)?)(.*)$/);if(!m)return;const to=parseFloat(m[1]),d=(m[1].split(".")[1]||"").length,t0=performance.now();const f=t=>{const p=Math.min(1,(t-t0)/1200),v=to*(1-Math.pow(1-p,3));el.textContent=v.toFixed(d)+m[2];if(p<1)requestAnimationFrame(f)};requestAnimationFrame(f)};
const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add("in");e.target.querySelectorAll("[data-n]").forEach(count);io.unobserve(e.target)}}),{threshold:.08});
document.querySelectorAll(".reveal").forEach(s=>io.observe(s));
/* card spotlight */
document.addEventListener("mousemove",e=>{const c=e.target.closest(".card");if(c){const r=c.getBoundingClientRect(),x=e.clientX-r.left,y=e.clientY-r.top;c.style.setProperty("--mx",x+"px");c.style.setProperty("--my",y+"px");if(!c.classList.contains("pat")){c.style.setProperty("--rx",((y/r.height-.5)*-5).toFixed(2)+"deg");c.style.setProperty("--ry",((x/r.width-.5)*5).toFixed(2)+"deg")}}});
document.addEventListener("mouseout",e=>{const c=e.target.closest(".card");if(c&&!c.contains(e.relatedTarget)){c.style.setProperty("--rx","0deg");c.style.setProperty("--ry","0deg")}});
/* floating petals & sparkles */
const cv=$("fx"),cx=cv.getContext("2d");let W,H;const size=()=>{W=cv.width=innerWidth;H=cv.height=innerHeight};size();addEventListener("resize",size);
const cols=["255,150,196","214,170,255","255,190,165","255,210,235"],PT=[];
for(let i=0;i<(innerWidth<700?14:30);i++)PT.push({x:Math.random()*innerWidth,y:Math.random()*innerHeight,r:4+Math.random()*9,s:.25+Math.random()*.6,a:Math.random()*6.28,w:.01+Math.random()*.02,c:cols[i%4],k:i%5===0,o:.3+Math.random()*.4});
function draw(){cx.clearRect(0,0,W,H);for(const p of PT){p.y+=p.s;p.x+=Math.sin(p.a)*.5;p.a+=p.w;if(p.y>H+20){p.y=-20;p.x=Math.random()*W}cx.save();cx.translate(p.x,p.y);cx.rotate(p.a);cx.fillStyle=`rgba(${p.c},${p.o})`;cx.beginPath();if(p.k){for(let j=0;j<8;j++){const rr=j%2?p.r*.25:p.r*1.1,an=j*Math.PI/4;cx.lineTo(Math.cos(an)*rr,Math.sin(an)*rr)}cx.closePath()}else cx.ellipse(0,0,p.r,p.r*.55,0,0,6.283);cx.fill();cx.restore()}requestAnimationFrame(draw)}
if(!matchMedia("(prefers-reduced-motion:reduce)").matches)draw();
/* back to top */
const up=$("up");up.onclick=()=>scrollTo({top:0,behavior:"smooth"});addEventListener("scroll",()=>up.classList.toggle("on",scrollY>700),{passive:true});
</script>
</body>
</html>
